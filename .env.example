DATABASE_URL="mysql://user:password@localhost:3306/trinchao3d"

MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REDIRECT_URI=http://localhost:3001/api/auth/mercadolivre/callback

SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=http://localhost:3001/api/auth/shopee/callback

FRONTEND_ORIGIN=http://localhost:5173

# URL publica (https) de onde os marketplaces conseguem baixar as imagens dos produtos.
# Em dev, use o mesmo tunel ngrok do MERCADOLIVRE_REDIRECT_URI. Sem isso, cai no origin da
# request (localhost em dev) e o ML nunca consegue baixar a foto (status "picture_download_pending").
PUBLIC_BASE_URL=

# Chave da API do Gemini (https://aistudio.google.com/apikey) — pro botao "Gerar com IA" na
# descricao do produto. GEMINI_MODEL e opcional, so mexer se o modelo padrao parar de existir.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
